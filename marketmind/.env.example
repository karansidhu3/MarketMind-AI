# MarketMind — environment variables
# Copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://marketmind:marketmind@localhost:5432/marketmind
POSTGRES_USER=marketmind
POSTGRES_PASSWORD=marketmind
POSTGRES_DB=marketmind

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of your Ollama instance. Can be local or remote (e.g. a desktop GPU box).
# Required models: qwen3:8b (reasoning), nomic-embed-text (embeddings)
# Pull with: ollama pull qwen3:8b && ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-before-running

# ── Ingestion scheduler ───────────────────────────────────────────────────────
# Hour (Pacific Time) to run daily ingestion. Default: 6 (6:00 AM PT)
# DST is handled automatically — no UTC math needed.
INGEST_HOUR_PT=6
